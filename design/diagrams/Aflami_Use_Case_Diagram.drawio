<mxfile host="drawio" type="device"><diagram id="uc" name="Use cases"><mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1350" pageHeight="1274" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Aflami: use case diagram 1 of 3, overview&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;All 16 main use cases and 7 actors. Diagrams 2 and 3 open up the two most complex areas.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Aflami&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4D4D4D;verticalAlign=top;align=center;fontSize=15;spacingTop=8;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="790" height="1014" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;UC-01&lt;/b&gt;&lt;br&gt;Register and sign in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="270" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;UC-12&lt;/b&gt;&lt;br&gt;Watch a film page" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="268" width="270" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;UC-14&lt;/b&gt;&lt;br&gt;Rate a film" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="386" width="270" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;UC-02&lt;/b&gt;&lt;br&gt;Create a project and add the script" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="504" width="270" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;UC-13&lt;/b&gt;&lt;br&gt;Respond to an invitation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="622" width="270" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;UC-05&lt;/b&gt;&lt;br&gt;Apply to a casting call" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="270" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;UC-03&lt;/b&gt;&lt;br&gt;Give a member manager rights" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="270" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;UC-11&lt;/b&gt;&lt;br&gt;Publish the film page" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="820" y="246" width="270" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;UC-15&lt;/b&gt;&lt;br&gt;Hide or show the film page" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="820" y="342" width="270" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;UC-04&lt;/b&gt;&lt;br&gt;Publish a casting call" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fon