lor=#4D4D4D;strokeWidth=1.2;exitX=0.0000;exitY=0.3500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=none;html=1;strokeColor=#4D4D4D;strokeWidth=1.2;exitX=0.0000;exitY=0.3500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="endArrow=none;html=1;strokeColor=#4D4D4D;strokeWidth=1.2;exitX=0.0000;exitY=0.3500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c24" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="endArrow=none;html=1;strokeColor=#4D4D4D;strokeWidth=1.2;exitX=0.0000;exitY=0.3500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c25" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="«extend»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#4D4D4D;strokeWidth=1.2;fontSize=11;fontColor=#4D4D4D;labelBackgroundColor=#FAFAFA;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A hollow arrow between actors means &quot;is a kind of&quot;: the actor at its tail can do everything the actor at its head can. Owner, Manager and Member are permissions a Creator holds inside one project; an Applicant is a Creator applying to a casting call.&lt;br&gt;A dashed «include» arrow points from a use case to a step it always runs. A dashed «extend» arrow points from an optional use case to the one it adds to. White ovals are supporting use cases, shared by several others." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1144" width="1290" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>