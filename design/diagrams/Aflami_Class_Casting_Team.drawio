00;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="k17" target="k19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k82" value="" style="html=1;rounded=0;strokeColor=#4D4D4D;strokeWidth=1.2;fontSize=11;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;dashed=1;startArrow=none;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8400;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="k17" target="k5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k83" value="" style="html=1;rounded=0;strokeColor=#4D4D4D;strokeWidth=1.2;fontSize=11;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;endArrow=none;startArrow=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.9000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="k19" target="k31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k84" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;spacing=1;" vertex="1" connectable="0" parent="k83"><mxGeometry x="-0.724" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="k85" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;spacing=1;" vertex="1" connectable="0" parent="k83"><mxGeometry x="0.889" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="k86" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A solid line is an association; the numbers at its ends say how many (1 exactly one, 0..1 zero or one, 0..* zero or more, 1..* one or more). A filled diamond means composition: the part cannot exist without the whole (an application without its casting call). A dashed open arrow means &quot;uses&quot;: a service calls another service or changes that class. Attributes start with -, methods with +; [0..1] marks an optional value. Service methods that take an actor check that person's permission first. FilmRole is the fixed list of film roles, in credit order; SDD section 2.1 gives each one in English and Arabic. Announcement.audienceRole is stored for a Future feature and stays empty in version 1." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="1625.0" width="1729" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>