<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="credit"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1133" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Aflami: state diagram 3 of 4, the credits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;Step 4 of the journey, first half: from the team&#x27;s film roles to credits ready to publish. The top part is one line (credits.status, CreditStatus); the bottom part is what the whole list shows.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1560" height="60" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="1180" height="379.6" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;One credit line&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· credits.status&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="432" y="116" width="1156" height="18" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;the person leaves the project&lt;/b&gt; (Should) / the line shows &quot;left the project&quot; for review, read from the membership&#x27;s status; the state does not change" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="430" y="138" width="1160" height="23.2" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="420" y="169.2" as="sourcePoint"/><mxPoint x="1600" y="169.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v6" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="49" y="268.2" width="22" height="22" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;open Credits&lt;/b&gt;&lt;br&gt;(Owner, Manager)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;after step 3&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="209.2" width="140" height="43.6" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="71" y="279.2" as="sourcePoint"/><mxPoint x="542" y="279.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v9" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="542" y="261.2" width="36" height="36" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="560" y="297.2" as="sourcePoint"/><mxPoint x="720" y="309.2" as="targetPoint"/><Array as="points"><mxPoint x="560" y="309.2"/></Array></mxGeometry></mxCell><mxCell id="v11" value="[no credits yet]&lt;br&gt;/ proposeFromTeam: one line for each active member&#x27;s film role, in film role order, then by join date (UC-10, SDD 2.1)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="568" y="315.2" width="148" height="83.2" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="578" y="279.2" as="sourcePoint"/><mxPoint x="720" y="279.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v13" value="[credits already proposed]&lt;br&gt;/ add lines only for new members or new film roles; edited and approved lines stay as they are (week 13)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="582" y="203.2" width="140" height="70" as="geometry"/></mxCell><mxCell id="v14" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="254.2" width="430" height="86.4" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Proposed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;PROPOSED&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="258.2" width="430" height="36" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="720" y="296.2" as="sourcePoint"/><mxPoint x="1150" y="296.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v17" value="&lt;b&gt;edit&lt;/b&gt; (Owner, Manager) / change the name, film role or character name (US-TEAM-04)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="728" y="302.2" width="414" height="30.4" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1150" y="279.2" as="sourcePoint"/><mxPoint x="1320" y="279.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v19" value="&lt;b&gt;approve&lt;/b&gt; (Owner, Manager)&lt;br&gt;/ approvedBy;&lt;br&gt;activity log (US-PRJ-05)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1158" y="229.6" width="168" height="43.6" as="geometry"/></mxCell><mxCell id="v20" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="254.2" width="250" height="86.4" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Approved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;APPROVED&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1320" y="258.2" width="250" height="36" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1320" y="296.2" as="sourcePoint"/><mxPoint x="1570" y="296.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v23" value="shown on the public film page while the project is Published (SD-3)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="1328" y="302.2" width="234" height="30.4" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1445" y="340.6" as="sourcePoint"/><mxPoint x="1021" y="340.6" as="targetPoint"/><Array as="points"><mxPoint x="1445" y="386.6"/><mxPoint x="1021" y="386.6"/></Array></mxGeometry></mxCell><mxCell id="v25" value="&lt;b&gt;edit&lt;/b&gt; (Owner, Manager) / clear the approval; it must be approved again" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1031" y="364.6" width="420" height="17.2" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="800" y="340.6" as="sourcePoint"/><mxPoint x="800" y="437.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v27" value="" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="787" y="437.6" width="26" height="26" as="geometry"/></mxCell><mxCell id="v28" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="792" y="442.6" width="16" height="16" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;remove&lt;/b&gt; (Owner, Manager)&lt;br&gt;/ delete the line; a Proposed line only (UC-10, 3a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="812" y="408.6" width="300" height="30.4" as="geometry"/></mxCell><mxCell id="v30" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="539.6" width="1560" height="251" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;The credits list&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· worked out from every line&#x27;s status, not saved&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="545.6" width="1536" height="18" as="geometry"/></mxCell><mxCell id="e32" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="40" y="571.6" as="sourcePoint"/><mxPoint x="1600" y="571.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v33" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="69" y="630.6" width="22" height="22" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="91" y="641.6" as="sourcePoint"/><mxPoint x="140" y="641.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v35" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="140" y="616.6" width="200" height="50" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;No credits yet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;the team is still working&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="620.6" width="200" height="36" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="340" y="641.6" as="sourcePoint"/><mxPoint x="520" y="641.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v38" value="&lt;b&gt;open Credits&lt;/b&gt; (Owner, Manager)&lt;br&gt;/ proposeFromTeam (UC-10)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="350" y="603.6" width="170" height="30.4" as="geometry"/></mxCell><mxCell id="v39" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="520" y="616.6" width="470" height="144" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;Being reviewed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;some line is Proposed&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="620.6" width="470" height="36" as="geometry"/></mxCell><mxCell id="e41" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="520" y="658.6" as="sourcePoint"/><mxPoint x="990" y="658.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v42" value="&lt;b&gt;edit&lt;/b&gt;, &lt;b&gt;remove&lt;/b&gt;, &lt;b&gt;approve&lt;/b&gt; one line / as in the top part" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="528" y="664.6" width="454" height="17.2" as="geometry"/></mxCell><mxCell id="v43" value="&lt;b&gt;approve all&lt;/b&gt; (Owner, Manager) / approve runs for each Proposed line, each with its own approvedBy and its own activity log line (UC-10 step 4, SD-3)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="528" y="683.8" width="454" height="30.4" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b&gt;add&lt;/b&gt; (Owner, Manager) (Should) [a name and a film role] / a Proposed line for someone without an Aflami account" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="528" y="716.2" width="454" height="36.4" as="geometry"/></mxCell><mxCell id="v45" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="616.6" width="250" height="50" as="geometry"/></mxCell><mxCell id="v46" value="&lt;b&gt;All approved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;every line is Approved&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1160" y="620.6" width="250" height="36" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="990" y="633.6" as="sourcePoint"/><mxPoint x="1160" y="633.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v48" value="&lt;b&gt;when&lt;/b&gt;(every line is Approved)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1000" y="611.6" width="170" height="17.2" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1160" y="655.6" as="sourcePoint"/><mxPoint x="990" y="655.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v50" value="&lt;b&gt;edit&lt;/b&gt; a line, or &lt;b&gt;open Credits&lt;/b&gt; after new members join" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1000" y="661.6" width="170" height="30.4" as="geometry"/></mxCell><mxCell id="v51" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1360" y="830.6" width="220" height="50" as="geometry"/></mxCell><mxCell id="v52" value="&lt;b&gt;The film page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;publishing · state diagram 4&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="834.6" width="220" height="36" as="geometry"/></mxCell><mxCell id="v53" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1546" y="866.6" width="10" height="7" as="geometry"/></mxCell><mxCell id="v54" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1562" y="866.6" width="10" height="7" as="geometry"/></mxCell><mxCell id="e55" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1556" y="870.1" as="sourcePoint"/><mxPoint x="1562" y="870.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e56" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1355" y="666.6" as="sourcePoint"/><mxPoint x="1470" y="830.6" as="targetPoint"/><Array as="points"><mxPoint x="1355" y="808.6"/><mxPoint x="1470" y="808.6"/></Array></mxGeometry></mxCell><mxCell id="v57" value="&lt;b&gt;publish&lt;/b&gt; (Owner)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1365" y="675.6" width="130" height="17.2" as="geometry"/></mxCell><mxCell id="v58" value="&lt;b&gt;Proposed once&lt;/b&gt; (week 13). Opening Credits again only adds lines for new members or new film roles. A character name set on the Team page later, or a film role taken away (Should), does not change a line: edit or remove it by hand." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="906.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;Published is not a credit state.&lt;/b&gt; Publishing belongs to the project (state diagram 4): only the owner publishes (FR-FILM-03), and ProjectService.missingForPublish lists any line that is not Approved. Slide 11 of the first presentation changes to match." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="434" y="906.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v60" value="&lt;b&gt;Editing after publishing.&lt;/b&gt; An edited line is Proposed again and leaves the public page until it is approved again, because the page shows Approved lines only (SD-3). The project stays Published." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="828" y="906.6" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v61" value="&lt;b&gt;All approved is not saved.&lt;/b&gt; It is worked out from credits.status. A line for someone without an Aflami account (Should) has no membership, follows the same states and is never changed by proposeFromTeam." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1222" y="906.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v62" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A rounded box is a state; the small text under its name is the saved status, or what it stands for when nothing is saved. The black dot is where it starts, and the circled dot is where a removed line ends; an Approved line ends only with its project. An arrow is a transition, labelled &lt;i&gt;event (who may trigger it) [condition] / what the system does&lt;/i&gt;; a diamond is a choice, and the path whose [condition] is true is taken. Text under a line inside a state is an internal transition, which leaves the state unchanged; &lt;i&gt;when(…)&lt;/i&gt; fires once its condition becomes true. A large box around other states is a composite state: the transitions at its top work in every state inside it. A dashed box is a Should feature; a box with the linked-boxes icon is drawn in the diagram it names. Before every event a person triggers, PermissionGuard.canAct checks the actor (UC-22).&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-FILM-01, FR-FILM-03, FR-ACC-02; UC-10, UC-11; US-FILM-01, US-FILM-03, US-TEAM-04, US-PRJ-05; DD-13, DD-18, DD-22; SD-3." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1009.4" width="1560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>