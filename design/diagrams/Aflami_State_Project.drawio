<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="project"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Aflami: state diagram 4 of 4, project and film page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;The whole project, from creation to a public film or series page, then hidden and shown again (projects.status, ProjectStatus).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1560" height="60" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1300" height="434.6" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Draft&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· DRAFT · only the team can open the page&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="312" y="116" width="1276" height="18" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;update&lt;/b&gt; (Owner, Manager) / the title, the idea and the film details (US-FILM-02)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="310" y="138" width="1280" height="17.2" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;upload script&lt;/b&gt; (Owner, Manager, Screenwriter) [PDF, Word, Pages or text, up to 10 MB] / keep only the newest (UC-17, DD-16); otherwise refuse and say why (UC-02, 5a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="310" y="159.2" width="1280" height="17.2" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;film or series&lt;/b&gt; (Owner) (Should) / a series has seasons and episodes (FR-PRJ-03)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="310" y="180.4" width="1280" height="23.2" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="300" y="211.6" as="sourcePoint"/><mxPoint x="1600" y="211.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v8" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="340" y="270.6" width="220" height="50" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Setting up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;step 1 · the details and the script&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="340" y="274.6" width="220" height="36" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="560" y="295.6" as="sourcePoint"/><mxPoint x="680" y="295.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;add people&lt;/b&gt;&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="570" y="257.6" width="120" height="30.4" as="geometry"/></mxCell><mxCell id="v12" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="680" y="270.6" width="300" height="62" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Team, work and credits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;steps 2 to 4 · state diagrams 1, 2 and 3&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="274.6" width="300" height="36" as="geometry"/></mxCell><mxCell id="v14" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="946" y="318.6" width="10" height="7" as="geometry"/></mxCell><mxCell id="v15" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="962" y="318.6" width="10" height="7" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="956" y="322.1" as="sourcePoint"/><mxPoint x="962" y="322.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="980" y="295.6" as="sourcePoint"/><mxPoint x="1090" y="295.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;open settings&lt;/b&gt;&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="990" y="257.6" width="110" height="30.4" as="geometry"/></mxCell><mxCell id="v19" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1090" y="270.6" width="490" height="144" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Preparing the film page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;step 4 · the synopsis, the details and the video&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1090" y="274.6" width="490" height="36" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1090" y="312.6" as="sourcePoint"/><mxPoint x="1580" y="312.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v22" value="&lt;b&gt;update&lt;/b&gt; (Owner, Manager) / the synopsis, genre, duration, year and language (US-FILM-02)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="1098" y="318.6" width="474" height="17.2" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;updateEpisode&lt;/b&gt; (Owner, Manager) [a YouTube video link] / save the film&#x27;s video link (US-FILM-02, SD-3)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="1098" y="337.8" width="474" height="30.4" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;AI draft&lt;/b&gt; (Owner, Manager) (Should) / the title and the description, with the participants&#x27; names; a person approves, edits or rejects it first (scope rows 87, 88)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1098" y="370.2" width="474" height="36.4" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1210" y="414.6" as="sourcePoint"/><mxPoint x="1210" y="466.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v26" value="&lt;b&gt;publish&lt;/b&gt; (Owner) (UC-11)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1220" y="431.6" width="170" height="17.2" as="geometry"/></mxCell><mxCell id="v27" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1192" y="466.6" width="36" height="36" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1192" y="484.6" as="sourcePoint"/><mxPoint x="1090" y="315.6" as="targetPoint"/><Array as="points"><mxPoint x="1060" y="484.6"/><mxPoint x="1060" y="315.6"/></Array></mxGeometry></mxCell><mxCell id="v29" value="[missingForPublish lists something: no YouTube link, or a credit not Approved]&lt;br&gt;/ show what is missing; stays Draft (UC-11, 4a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="462.8" width="300" height="43.6" as="geometry"/></mxCell><mxCell id="v30" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="49" y="284.6" width="22" height="22" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="71" y="295.6" as="sourcePoint"/><mxPoint x="152" y="295.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v32" value="&lt;b&gt;create&lt;/b&gt;&lt;br&gt;(signed-in user)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="245.6" width="110" height="30.4" as="geometry"/></mxCell><mxCell id="v33" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="152" y="277.6" width="36" height="36" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="188" y="295.6" as="sourcePoint"/><mxPoint x="340" y="295.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v35" value="[a Creator]&lt;br&gt;/ a draft film, the Creator as its owner, and its single episode (UC-02)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="190" y="219.6" width="106" height="70" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="170" y="313.6" as="sourcePoint"/><mxPoint x="170" y="392.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v37" value="" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="157" y="392.6" width="26" height="26" as="geometry"/></mxCell><mxCell id="v38" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="162" y="397.6" width="16" height="16" as="geometry"/></mxCell><mxCell id="v39" value="[a Viewer]&lt;br&gt;/ ask them to switch to Creator first; nothing is made (UC-02, 1a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="321.6" width="120" height="56.8" as="geometry"/></mxCell><mxCell id="v40" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="900" y="654.6" width="680" height="194.4" as="geometry"/></mxCell><mxCell id="v41" value="&lt;b&gt;Published&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;PUBLISHED · anyone can open the page&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="658.6" width="680" height="36" as="geometry"/></mxCell><mxCell id="e42" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="900" y="696.6" as="sourcePoint"/><mxPoint x="1580" y="696.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v43" value="&lt;b&gt;watch&lt;/b&gt; (anyone, no account needed) / the details, the Approved credits, the rating and the YouTube player; no email addresses (UC-12, NFR-PRV-02)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="908" y="702.6" width="664" height="30.4" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b&gt;rate&lt;/b&gt; (a Creator outside the team) (Should) [1 to 5 stars] / one rating each, which they can change; the page shows the average and the count (UC-14, US-FILM-06)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="908" y="735" width="664" height="36.4" as="geometry"/></mxCell><mxCell id="v45" value="&lt;b&gt;update&lt;/b&gt; (Owner, Manager) / the page shows the change at once" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="908" y="773.4" width="664" height="17.2" as="geometry"/></mxCell><mxCell id="v46" value="&lt;b&gt;react&lt;/b&gt; (a signed-in user) (Should) / like or dislike, one per account (scope row 58)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="908" y="792.6" width="664" height="23.2" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b&gt;publish episode&lt;/b&gt; (Owner) (Should) / a series releases its episodes one at a time" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="908" y="817.8" width="664" height="23.2" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1210" y="502.6" as="sourcePoint"/><mxPoint x="1210" y="654.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v49" value="[nothing missing]&lt;br&gt;/ publishedAt; the episode becomes Published; the page is public (UC-11, SD-3)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1222" y="560.6" width="300" height="43.6" as="geometry"/></mxCell><mxCell id="v50" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="300" y="654.6" width="260" height="50" as="geometry"/></mxCell><mxCell id="v51" value="&lt;b&gt;Hidden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;HIDDEN · only the team can open it&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="300" y="658.6" width="260" height="36" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="900" y="670.6" as="sourcePoint"/><mxPoint x="560" y="670.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v53" value="&lt;b&gt;hide&lt;/b&gt; (Owner)&lt;br&gt;/ setHidden(true): visitors see that the film is not available; the team still can (UC-15)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="570" y="621" width="320" height="43.6" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="560" y="692.6" as="sourcePoint"/><mxPoint x="900" y="692.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v55" value="&lt;b&gt;show&lt;/b&gt; (Owner)&lt;br&gt;/ setHidden(false): public again, with its ratings kept (UC-15, 2a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="570" y="698.6" width="320" height="43.6" as="geometry"/></mxCell><mxCell id="v56" value="&lt;b&gt;Only the owner publishes, hides and shows&lt;/b&gt; (FR-FILM-03). A manager prepares everything else and is refused at these three events (UC-11 4b, UC-15 3a)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="883" width="300" height="74.8" as="geometry"/></mxCell><mxCell id="v57" value="&lt;b&gt;Who can open the film page.&lt;/b&gt; Draft or Hidden: the team only; a visitor sees that the film is not available (UC-12, 1a). Published: anyone, without signing in (FR-FILM-02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="355" y="883" width="300" height="74.8" as="geometry"/></mxCell><mxCell id="v58" value="&lt;b&gt;Credits after publishing.&lt;/b&gt; Publishing checks the credits once. A line edited later leaves the page until it is approved again (state diagram 3); the project stays Published." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="670" y="883" width="300" height="74.8" as="geometry"/></mxCell><mxCell id="v59" value="&lt;b&gt;No way back to Draft, and no final state.&lt;/b&gt; A published project is hidden, never unpublished. Archiving or deleting a project is Should and not decided yet (scope row 43)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="985" y="883" width="300" height="74.8" as="geometry"/></mxCell><mxCell id="v60" value="&lt;b&gt;Series&lt;/b&gt; (Should, DD-11). Each episode has its own status, Draft or Published (EpisodeStatus); a film&#x27;s only episode is published with the project." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1300" y="883" width="300" height="61.6" as="geometry"/></mxCell><mxCell id="v61" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A rounded box is a state; the small text under its name is the saved status and who can open the page. The black dot is where the project starts, and the circled dot is where nothing is created. An arrow is a transition, labelled &lt;i&gt;event (who may trigger it) [condition] / what the system does&lt;/i&gt;; a diamond is a choice, and the path whose [condition] is true is taken. Text under a line inside a state is an internal transition, which leaves the state unchanged. A large box around other states is a composite state: the transitions at its top work in every state inside it. A dashed box is a Should feature; a box with the linked-boxes icon is drawn in the diagrams it names. Before every event, PermissionGuard.canAct checks the actor (UC-22); hide and show are one method, ProjectService.setHidden.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-PRJ-01, FR-PRJ-02, FR-PRJ-03, FR-PRJ-04, FR-FILM-02, FR-FILM-03, FR-ACC-02, NFR-PRV-02; UC-02, UC-11, UC-12, UC-14, UC-15; US-FILM-02 to US-FILM-06; DD-10, DD-11, DD-16, DD-22." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="985.8" width="1560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>