1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1639.18" y="2422" as="sourcePoint" /><mxPoint x="1246.38" y="2422" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e124" value="54. page data, no email addresses" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1234.38" y="2494" as="sourcePoint" /><mxPoint x="555.811" y="2494" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e125" value="55. load the embedded player (video id)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="555.811" y="2528" as="sourcePoint" /><mxPoint x="1789.18" y="2528" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e126" value="56. player" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1789.18" y="2562" as="sourcePoint" /><mxPoint x="555.811" y="2562" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e127" value="57. show details, credits, rating and the player" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="543.811" y="2596" as="sourcePoint" /><mxPoint x="288.021" y="2596" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e128" value="58. play" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="288.021" y="2668" as="sourcePoint" /><mxPoint x="1789.18" y="2668" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e129" value="59. stream the video" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1789.18" y="2702" as="sourcePoint" /><mxPoint x="288.021" y="2702" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e130" value="60. not available" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1234.38" y="2786" as="sourcePoint" /><mxPoint x="555.811" y="2786" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e131" value="61. show that the film is not available" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="543.811" y="2820" as="sourcePoint" /><mxPoint x="288.021" y="2820" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="v132" value="[for each credit that needs a change]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="119.3" y="544" width="186.561" height="16" as="geometry" /></mxCell><mxCell id="v133" value="[for each credit to publish]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="119.3" y="876" width="133.957" height="16" as="geometry" /></mxCell><mxCell id="v134" value="[refused: a member without manager rights]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="559.8" y="1016" width="220.768" height="16" as="geometry" /></mxCell><mxCell id="v135" value="[allowed]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="559.8" y="1086" width="51.4121" height="16" as="geometry" /></mxCell><mxCell id="v136" value="[refused: not the owner]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="108" y="1766" width="123.57" height="16" as="geometry" /></mxCell><mxCell id="v137" value="[the owner]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="1870" width="62.4199" height="16" as="geometry" /></mxCell><mxCell id="v138" value="[YouTube link missing, or credits not all Approved]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="124" y="2024" width="250.535" height="16" as="geometry" /></mxCell><mxCell id="v139" value="[nothing missing]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="86" y="2128" width="90.541" height="16" as="geometry" /></mxCell><mxCell id="v140" value="[the project is PUBLISHED]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="108" y="2440" width="141.889" height="16" as="geometry" /></mxCell><mxCell id="v141" value="[DRAFT or HIDDEN]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="2734" width="108.639" height="16" as="geometry" /></mxCell><mxCell id="v142" value="[the visitor presses play]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="278.7" y="2614" width="125.992" height="16" as="geometry" /></mxCell><mxCell id="v143" value="&lt;b&gt;Rules.&lt;/b&gt; The owner or a manager may review and approve the credits; only the owner publishes (FR-FILM-03). Credits follow the film role list (SDD 2.1), then the date each person joined. Credits are proposed once: opening Credits again only adds lines for new members or new film roles. Editing an APPROVED credit sends it back to PROPOSED, so nothing reaches the page without approval. Every approval goes to the activity log (DD-18). missingForPublish lists what is missing: the YouTube link, or credits not yet Approved. The film's single episode is published with the project. The public page needs no account, so it skips canAct and returns only public fields. The video stays on YouTube, and nothing covers its player (DD-10).&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-FILM-01, FR-FILM-02, FR-FILM-03, FR-ACC-02, NFR-PRV-02; UC-10, UC-11, UC-12 with UC-22." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2890" width="1815.3" height="59.6" as="geometry" /></mxCell><mxCell id="v144" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Time runs from top to bottom. A box at the top is a participant: &lt;i&gt;:ApplicationService&lt;/i&gt; means an object of that class from the class diagrams, coloured by its module (orange Casting and team, purple Tasks, yellow Film page, green Projects, grey Shared; white for the web app, the database and YouTube). The dashed line under it is its lifeline, and the thin bar shows when it is busy. A solid arrow with a filled head is a call, written as the method and its arguments; a dashed arrow with an open head is the answer. A call that only saves something has no answer arrow. A frame groups messages: &lt;b&gt;alt&lt;/b&gt; runs only the part whose [condition] holds (dashed lines separate the parts), &lt;b&gt;opt&lt;/b&gt; runs only if its condition holds, and &lt;b&gt;loop&lt;/b&gt; repeats. Words in quotes, such as &quot;accept&quot;, are values whose exact names are set in the code. canAct is the permission check; SD-4 shows how it decides." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2963.6" width="1815.3" height="79.6" as="geometry" /></mxCell><mxCell id="x1" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1639" y="1212" width="12" height="16" as="geometry" /></mxCell><mxCell id="x2" value="25. insert activity line" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1501" y="1212" as="sourcePoint" /><mxPoint x="1639" y="1212" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>