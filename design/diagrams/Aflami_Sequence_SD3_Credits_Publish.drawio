"geometry"><mxPoint x="1246.38" y="1990" as="sourcePoint" /><mxPoint x="1252.38" y="2008" as="targetPoint" /><Array as="points"><mxPoint x="1276.38" y="1990" /><mxPoint x="1276.38" y="2008" /></Array></mxGeometry></mxCell><mxCell id="v114" value="44. missingForPublish(project)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1280.38" y="1981" width="156.553" height="18" as="geometry" /></mxCell><mxCell id="e115" value="45. the list of what is missing" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1234.38" y="2078" as="sourcePoint" /><mxPoint x="555.811" y="2078" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e116" value="46. show what must be fixed" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="543.811" y="2112" as="sourcePoint" /><mxPoint x="138.021" y="2112" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e117" value="47. save project: PUBLISHED, publishedAt; its episode: PUBLISHED" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1246.38" y="2180" as="sourcePoint" /><mxPoint x="1639.18" y="2180" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e118" value="48. published" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="