<mxfile host="drawio" type="device"><diagram id="aflami-story-map" name="Story map"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1790" pageHeight="1370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Aflami: user story map, version 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;Draft for CPIT-498. 34 user stories for the Must features, and the Should features planned after them; the star rating (US-FILM-06) is written but Should.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F9F1;strokeColor=#D0D0D0;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1710" height="698" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Must&lt;/b&gt;&lt;br&gt;Version 1&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;one card = one user story in SRS 3.2&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="48" y="200" width="134" height="120" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#D0D0D0;" vertex="1" parent="1"><mxGeometry x="40" y="912" width="1710" height="380" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Should&lt;/b&gt;&lt;br&gt;If time allows&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;features only; stories are written before they are built&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="48" y="922" width="134" height="120" as="geometry"/></mxCell><mxCe