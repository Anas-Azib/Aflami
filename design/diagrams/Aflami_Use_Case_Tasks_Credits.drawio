<mxfile host="drawio" type="device"><diagram id="uc" name="Use cases"><mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1650" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Aflami: use case diagram 3 of 3, tasks, credits and publishing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;From assigning work to approving the credits and publishing the film page.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Aflami&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4D4D4D;verticalAlign=top;align=center;fontSize=15;spacingTop=8;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="1090" height="480" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;UC-08&lt;/b&gt;&lt;br&gt;Create and assign a task" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="250" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;UC-10&lt;/b&gt;&lt;br&gt;Review and approve the credits" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="250" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;UC-16&lt;/b&gt;&lt;br&gt;Reopen a done task" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="390" width="250" height="60" as="geometry"/></m