<mxfile host="drawio" type="device"><diagram id="arch" name="Diagram"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;Aflami: deployment diagram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;Where each part runs in version 1, and how the parts talk to each other. Every service here has a free plan.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«device»&lt;/font&gt; &lt;b&gt;User&#x27;s phone or computer&lt;/b&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#FAFAFA;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="300" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«execution environment»&lt;/font&gt; &lt;b&gt;Web browser&lt;/b&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="58" y="172" width="284" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«artifact»&lt;/font&gt; &lt;b&gt;Web app pages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;HTML and JavaScript from aflami-web&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;align=left;verticalAlign=top;spacing=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="76" y="222" width="248" height="70" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=note;size=5;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="302" y="230" width="12" height="15" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«artifact»&lt;/font&gt; &lt;b&gt;YouTube player&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Embedded on the film page&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;align=left;verticalAlign=top;spacing=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="76" y="310" width="248" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=note;size=5;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="302" y="318" width="12" height="15" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«external service»&lt;/font&gt; &lt;b&gt;YouTube&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Hosts and streams the film&lt;/font&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#F7F7F7;strokeColor=#999999;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="320" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«external service»&lt;/font&gt; &lt;b&gt;AI model API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Should. Gets a script&#x27;s text only after the owner agrees&lt;/font&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#F7F7F7;strokeColor=#999999;fontColor=#1A1A1A;fontSize=11;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="320" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«cloud platform»&lt;/font&gt; &lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Hobby plan&lt;/font&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#FAFAFA;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="420" height="380" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«execution environment»&lt;/font&gt; &lt;b&gt;Vercel Functions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Node.js, Fluid compute, same region as Supabase&lt;/font&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="518" y="172" width="384" height="310" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«artifact»&lt;/font&gt; &lt;b&gt;aflami-web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;Next.js build: the pages, rendered on the server&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;font