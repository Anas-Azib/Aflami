yle="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1517" y="1995" width="26" height="26" as="geometry" /></mxCell><mxCell id="v83" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1522" y="2000" width="16" height="16" as="geometry" /></mxCell><mxCell id="e84" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="870" y="1366" as="sourcePoint" /><mxPoint x="870" y="1392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e85" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="870" y="1418" as="sourcePoint" /><mxPoint x="870" y="1448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e86" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="750" y="1470" as="sourcePoint" /><mxPoint x="450" y="1518" as="targetPoint" /><Array as="points"><mxPoint x="450" y="1470" /></Array></mxGeometry></mxCell><mxCell id="e87" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="570" y="1540" as="sourcePoint" /><mxPoint x="870" y="1592" as="targetPoint" /><Array as="points"><mxPoint x="870" y="1540" /></Array></mxGeometry></mxCell><mxCell id="e88" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="870" y="1628" as="sourcePoint" /><mxPoint x="870" y="1658" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e89" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="750" y="1680" as="sourcePoint" /><mxPoint x="450" y="1733" as="targetPoint" /><Array as="points"><mxPoint x="450" y="1680" /></Array></mxGeometry></mxCell><mxCell id="e90" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="360" y="1765" as="sourcePoint" /><mxPoint x="857" y="1405" as="targetPoint" /><Array as="points"><mxPoint x="315" y="1765" /><mxPoint x="315" y="1405" /></Array></mxGeometry></mxCell><mxCell id="v91" value="[no: the page shows what is missing]" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingRight=3;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="112" y="1748" width="198" height="15" as="geometry" /></mxCell><mxCell id="e92" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="450" y="1797" as="sourcePoint" /><mxPoint x="450" y="1838" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v93" value="[yes]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=3;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="456" y="1803" width="29.2305" height="15" as="geometry" /></mxCell><mxCell id="e94" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="570" y="1860" as="sourcePoint" /><mxPoint x="1530" y="1908" as="targetPoint" /><Array as="points"><mxPoint x="1530" y="1860" /></Array></mxGeometry></mxCell><mxCell id="e95" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1530" y="1952" as="sourcePoint" /><mxPoint x="1530" y="1995" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v96" value="The owner or a manager can also invite a known Creator (UC-07). When that person accepts, they join the team in the same way (UC-21), without a casting call." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=9;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="54" y="910" width="232" height="72.8" as="geometry" /></mxCell><mxCell id="v97" value="After the fork, casting and tasks run at the same time: tasks go to members as they join. The film page work starts only when both are finished (the join)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=9;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1414" y="150" width="232" height="72.8" as="geometry" /></mxCell><mxCell id="v98" value="A rejected applicant stays out of the project. A hidden or draft page shows &quot;not available&quot; to visitors (UC-12, UC-15)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=9;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1414" y="1410" width="232" height="59.6" as="geometry" /></mxCell><mxCell id="v99" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Each column is a lane: the steps in it are done by that person or by the system. A rounded box is a step, coloured by its module (green Projects, orange Casting and team, purple Tasks, yellow Film page). A diamond with a question is a decision, and the [conditions] on its arrows say which way the flow goes; a small empty diamond is a merge, where paths meet again. The black bar under the script step is a fork: both paths below it run at the same time. The lower bar is a join: the flow goes on only when both paths have finished. The black dot is the start and the circled dot is the end.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-PRJ-01, FR-CST-01, FR-CST-02, FR-TSK-01, FR-TSK-02, FR-FILM-01, FR-FILM-02, FR-FILM-03; UC-02, UC-04, UC-05, UC-06, UC-08, UC-09, UC-10, UC-11, UC-12, UC-16." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2075" width="1620" height="79.6" as="geometry" /></mxCell><mxCell id="x1" value="Add the script&lt;br&gt;now?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="805" y="310" width="130" height="52" as="geometry" /></mxCell><mxCell id="x2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="870" y="362" as="sourcePoint" /><mxPoint x="870" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="x3" value="[yes]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=3;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="876" y="366" width="36" height="15" as="geometry" /></mxCell><mxCell id="x4" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="857" y="550" width="26" height="26" as="geometry" /></mxCell><mxCell id="x5" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="450" y="507" as="sourcePoint" /><mxPoint x="857" y="563" as="targetPoint" /><Array as="points"><mxPoint x="4