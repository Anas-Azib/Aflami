A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="969.775" y="1032" as="sourcePoint" /><mxPoint x="975.775" y="1050" as="targetPoint" /><Array as="points"><mxPoint x="999.775" y="1032" /><mxPoint x="999.775" y="1050" /></Array></mxGeometry></mxCell><mxCell id="v64" value="21. check the user owns the task and the step is the next one" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1003.78" y="1023" width="306.404" height="18" as="geometry" /></mxCell><mxCell id="e65" value="22. save status: IN_PROGRESS or DONE" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="969.775" y="1120" as="sourcePoint" /><mxPoint x="1529.7" y="1120" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e66" value="23. task" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="957.775" y="1160" as="sourcePoint" /><mxPoint x="459.805" y="1160" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e67" value="24. show the new status" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="447.805" y="1194" as="sourcePoint" /><mxPoint x="288.021" y="1194" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e68" value="25. refused: nothing changes" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="957.775" y="1262" as="sourcePoint" /><mxPoint x="459.805" y="1262" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e69" value="26. show why" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="447.805" y="1296" as="sourcePoint" /><mxPoint x="288.021" y="1296" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e70" value="27. Choose Reopen" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="138.021" y="1400" as="sourcePoint" /><mxPoint x="447.805" y="1400" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e71" value="28. reopen(task, actor)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="459.805" y="1434" as="sourcePoint" /><mxPoint x="957.775" y="1434" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e72" value="29. canAct(actor, project, &quot;reopen task&quot;)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="957.775" y="1468" as="sourcePoint" /><mxPoint x="732.092" y="1468" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e73" value="30. allowed or refused" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="732.092" y="1502" as="sourcePoint" /><mxPoint x="957.775" y="1502" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e74" value="31. save status: IN_PROGRESS, keep its owner" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="969.775" y="1572" as="sourcePoint" /><mxPoint x="1529.7" y="1572" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e75" value="32. task" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="957.775" y="1612" as="sourcePoint" /><mxPoint x="459.805" y="1612" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e76" value="33. show In progress" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="447.805" y="1646" as="sourcePoint" /><mxPoint x="138.021" y="1646" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="v77" value="[refused, or the owner is not an active member of this project]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="124" y="470" width="306.367" height="16" as="geometry" /></mxCell><mxCell id="v78" value="[allowed]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="86" y="574" width="51.4121" height="16" as="geometry" /></mxCell><mxCell id="v79" value="[for each step: Start, then Finish]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="135.3" y="842" width="166.971" height="16" as="geometry" /></mxCell><mxCell id="v80" value="[allowed, task owner, next step]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="274" y="1066" width="160.859" height="16" as="geometry" /></mxCell><mxCell id="v81" value="[refused, not the task owner, or a skipped or backward step]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="463.8" y="1210" width="299.049" height="16" as="geometry" /></mxCell><mxCell id="v82" value="[a Done task needs more work (UC-16)]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="128.7" y="1346" width="202.408" height="16" as="geometry" /></mxCell><mxCell id="v83" value="&lt;b&gt;Rules.&lt;/b&gt; A task's owner is a membership: only an active member of the same project can be chosen, and the list can be filtered by film role (screen only). A task moves only To do, In progress, Done (FR-TSK-01). Only the owner or a manager reopens a Done task; a member is refused, even the task's own owner (FR-TSK-02). assign(task, owner, actor) runs the same checks when a task created without an owner gets one later (UC-08, 3a). canAct receives the project, not the task, so TaskService itself checks that the user owns the task.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-TSK-01, FR-TSK-02, FR-ACC-02; UC-08, UC-09, UC-16 with UC-20 and UC-22." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1812" width="1553.7" height="59.6" as="geometry" /></mxCell><mxCell id="v84" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Time runs from top to bottom. A box at the top is a participant: &lt;i&gt;:ApplicationService&lt;/i&gt; means an object of that class from the class diagrams, coloured by its module (orange Casting and team, purple Tasks, yellow Film page, green Projects, grey Shared; white for the web app, the database and YouTube). The dashed line under it is its lifeline, and the thin bar shows when it is busy. A solid arrow with a filled head is a call, written as the method and its arguments; a dashed arrow with an open head is the answer. A call that only saves something has no answer arrow. A frame groups messages: &lt;b&gt;alt&lt;/b&gt; runs only the part whose [condition] holds (dashed lines separate the parts), &lt;b&gt;opt&lt;/b&gt; runs only if its condition holds, and &lt;b&gt;loop&lt;/b&gt; repeats. Words in quotes, such as &quot;accept&quot;, are values whose exact names are set in the code. canAct is the permission check; SD-4 shows how it decides." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1885.6" width="1553.7" height="94" as="geometry" /></mxCell><mxCell id="x1" value="3. Enter title, description, deadline; choose the owner" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="138.021" y="282" as="sourcePoint" /><mxPoint x="447.805" y="282" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="x3" value="[allowed: the owner or a manager]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="136" y="1522" width="191.85" height="16" as="geometry" /></mxCell><mxCell id="x4" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#4D4D4D;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="92" y="1664" as="sourcePoint" /><mxPoint x="1577.7" y="1664" as="targetPoint" /></mxGeometry></mxCell><mxCell id="x5" value="[refused: a member, even the task's own owner (FR-TSK-02)]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="102" y="1666" width="328.1" height="16" as="geometry" /></mxCell><mxCell id="x6" value="" style="rounded=0;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="957.775" y="1664" width="12" height="40" as="geometry" /></mxCell><mxCell id="x7" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="447.805" y="1664" width="12" height="74" as="geometry" /></mxCell><mxCell id="x8" value="34. refused: nothing changes" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="957.775" y="1704" as="sourcePoint" /><mxPoint x="459.805" y="1704" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="x9" value="35. show why" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="447.805" y="1738" as="sourcePoint" /><mxPoint x="138.021" y="1738" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>