le=&quot;font-size: 11px;&quot;&gt;· casting_calls.status&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="242" y="414" width="1106" height="18" as="geometry"/></mxCell><mxCell id="e26" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="230" y="440" as="sourcePoint"/><mxPoint x="1360" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v27" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="260" y="481" width="230" height="118.8" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;Writing the casting call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;a film role, a description, a deadline&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="260" y="485" width="230" height="36" as="geometry"/></mxCell><mxCell id="e29" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="260" y="523" as="sourcePoint"/><mxPoint x="490" y="523" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v30" value="&lt;b&gt;AI draft&lt;/b&gt; (Owner, Manager) (Should) [the owner agreed to send the script] / a draft of the role and the call; a person approves or edits it (scope rows 85, 88)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="268" y="529" width="214" height="62.8" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=