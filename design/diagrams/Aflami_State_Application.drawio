as="geometry"><mxPoint x="1340" y="1113.8" as="sourcePoint"/><mxPoint x="1390" y="1113.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e103" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1310" y="234" as="sourcePoint"/><mxPoint x="1500" y="1058.8" as="targetPoint"/><Array as="points"><mxPoint x="1500" y="234"/></Array></mxGeometry></mxCell><mxCell id="v104" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1390" y="1306.4" width="220" height="50" as="geometry"/></mxCell><mxCell id="v105" value="&lt;b&gt;The tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;step 3 · state diagram 2&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="1310.4" width="220" height="36" as="geometry"/></mxCell><mxCell id="v106" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1576" y="1342.4" width="10" height="7" as="geometry"/></mxCell><mxCell id="v107" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1592" y="1342.4" width="10" height="7" as="geometry"/></mxCell><mxCell id="e108" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1586" y="1345.9" as="sourcePoint"/><mxPoint x="1592" y="1345.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e109" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1500" y="1236.4" as="sourcePoint"/><mxPoint x="1500" y="1306.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v110" value="&lt;b&gt;create task&lt;/b&gt;&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1508" y="1250.4" width="100" height="30.4" as="geometry"/></mxCell><mxCell id="v111" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="49" y="495" width="22" height="22" as="geometry"/></mxCell><mxCell id="e112" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="71" y="506" as="sourcePoint"/><mxPoint x="132" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v113" value="&lt;b&gt;add people&lt;/b&gt;&lt;br&gt;(Owner, Manager)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;from step 1&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="110" height="43.6" as="geometry"/></mxCell><mxCell id="v114" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="132" y="488" width="36" height="36" as="geometry"/></mxCell><mxCell id="e115" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="150" y="488" as="sourcePoint"/><mxPoint x="260" y="234" as="targetPoint"/><Array as="points"><mxPoint x="150" y="234"/></Array></mxGeometry></mxCell><mxCell id="v116" value="[a specific&lt;br&gt;person on&lt;br&gt;Aflami]" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="158" y="240" width="72" height="43.6" as="geometry"/></mxCell><mxCell id="e117" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="168" y="506" as="sourcePoint"/><mxPoint x="260" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v118" value="[no one&lt;br&gt;specific&lt;br&gt;yet]" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="172" y="512" width="70" height="43.6" as="geometry"/></mxCell><mxCell id="v119" value="&lt;b&gt;When a call closes.&lt;/b&gt; The owner or a manager closes it (CastingService.closeCall), or the daily job closes it once its deadline has passed. Closing stops new applications only: Submitted ones stay for the team to decide (open question 3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1443.4" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v120" value="&lt;b&gt;Why submit checks the deadline too.&lt;/b&gt; The daily job runs once a day, so a call can still be Open for some hours after its deadline; submit refuses those late applications (UC-05, 4a)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="434" y="1443.4" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v121" value="&lt;b&gt;No way out of Accepted, Rejected or Declined.&lt;/b&gt; A decision is not undone in version 1, and withdrawing an application is Future (scope row 70). The records go only with their project, so there is no final state." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="828" y="1443.4" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v122" value="&lt;b&gt;Who sees what.&lt;/b&gt; An application is visible only to its applicant and to the owner and managers (NFR-PRV-05); the shortlist mark only to the team (DD-14). An accepted applicant&#x27;s photo is kept; SRS 3.5 deletes only the others." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1222" y="1443.4" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v123" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A rounded box is a state; the small text under its name is the saved status, or what it stands for when nothing is saved yet. A black dot is where a path starts, and the circled dot is where it ends with nothing saved. An arrow is a transition, labelled &lt;i&gt;event (who may trigger it) [condition] / what the system does&lt;/i&gt;; a diamond is a choice, and the path whose [condition] is true is taken. Text under a line inside a state is an internal transition, which leaves the state unchanged; &lt;i&gt;when(…)&lt;/i&gt; fires once its condition becomes true. A dashed box is a Should feature; a box with the linked-boxes icon is drawn in the diagram it names. The team&#x27;s events pass PermissionGuard.canAct first (UC-22); a refused event changes nothing and says why.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-CST-01, FR-CST-02, FR-TEAM-02, FR-ACC-02, NFR-PRV-02, NFR-PRV-05, NFR-PRV-06, NFR-SEC-04; UC-04, UC-05, UC-06, UC-07, UC-13, UC-17, UC-19, UC-21; US-CST-02 to US-CST-06; DD-13, DD-14, DD-17, DD-19; SRS 3.5." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1546.2" width="1560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>