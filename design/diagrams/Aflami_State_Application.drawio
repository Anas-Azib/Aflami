<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="application"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1670" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Aflami: state diagram 1 of 4, building the team&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;Step 2 of the journey: a person joins the project by invitation, or through a casting call and an application (invitations.status, casting_calls.status, applications.status).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1560" height="60" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1130" height="276" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Invitation&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· invitations.status; only for people already on Aflami (DD-17)&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="242" y="116" width="1106" height="18" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="230" y="142" as="sourcePoint"/><mxPoint x="1360" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v5" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="260" y="209" width="230" height="50" as="geometry"/></mxCe