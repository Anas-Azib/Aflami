<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="task"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1235" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Aflami: state diagram 2 of 4, distributing the work (tasks)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;Step 3 of the journey: from writing a task to every task Done. The top part is one task (tasks.status, TaskStatus); the bottom part is what the project&#x27;s task list shows.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1560" height="60" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="1180" height="507.8" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;One task&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· tasks.status&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="432" y="116" width="1156" height="18" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;attach&lt;/b&gt; (member) [an image or a file up to 10 MB of an allowed type, or a link] / add it to the task; otherwise refuse and say why (UC-18, US-TSK-04, NFR-SEC-04)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="430" y="138" width="1160" height="17.2" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="420" y="163.2" as="sourcePoint"/><mxPoint x="1600" y="163.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v6" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="185.2" width="600" height="364.6" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Open (To do or In progress)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="652" y="191.2" width="576" height="18" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;assign&lt;/b&gt; (Owner, Manager) [an active member] / set or change the owner; notify them (UC-08, UC-20)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="650" y="213.2" width="580" height="17.2" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;the owner leaves the project&lt;/b&gt; (Should) / the task has no owner; nobody can start or finish it until a new owner is assigned" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="650" y="234.4" width="580" height="36.4" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="640" y="278.8" as="sourcePoint"/><mxPoint x="1240" y="278.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v11" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="680" y="315.8" width="210" height="50" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;To do, no owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;TO_DO, owner empty&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="319.8" width="210" height="36" as="geometry"/></mxCell><mxCell id="v13" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="680" y="465.8" width="210" height="50" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;To do&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;TO_DO&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="469.8" width="210" height="36" as="geometry"/></mxCell><mxCell id="v15" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1010" y="465.8" width="200" height="50" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;In progress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;IN_PROGRESS&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="469.8" width="200" height="36" as="geometry"/></mxCell><mxCell id="v17" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1360" y="465.8" width="210" height="50" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;DONE&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="469.8" width="210" height="36" as="geometry"/></mxCell><mxCell id="v19" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="30" y="280.8" width="300" height="164.4" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Writing the task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;a title, a description, a deadline and maybe an owner&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="284.8" width="300" height="36" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="30" y="322.8" as="sourcePoint"/><mxPoint x="330" y="322.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v22" value="&lt;b&gt;filter&lt;/b&gt; (Owner, Manager) / list only the members with one film role, for example the Colorists (week 13, screen only)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="38" y="328.8" width="284" height="43.6" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;AI draft&lt;/b&gt; (Owner, Manager) (Should) [the owner agreed to send the script] / tasks by scene, character and location; a person approves, edits or rejects each one (scope rows 86, 88)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="38" y="374.4" width="284" height="62.8" as="geometry"/></mxCell><mxCell id="v24" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="169" y="223.8" width="22" height="22" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="180" y="245.8" as="sourcePoint"/><mxPoint x="180" y="280.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v26" value="&lt;b&gt;New task&lt;/b&gt; (Owner, Manager)&lt;br&gt;/ open the form (UC-08)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="194" y="220.8" width="200" height="30.4" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="330" y="340.8" as="sourcePoint"/><mxPoint x="432" y="340.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v28" value="&lt;b&gt;create&lt;/b&gt;&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="336" y="304.8" width="100" height="30.4" as="geometry"/></mxCell><mxCell id="v29" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="432" y="322.8" width="36" height="36" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="468" y="340.8" as="sourcePoint"/><mxPoint x="680" y="340.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v31" value="[no owner yet]&lt;br&gt;/ save To do without an owner (UC-08, 3a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="472" y="291.2" width="164" height="43.6" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="450" y="358.8" as="sourcePoint"/><mxPoint x="680" y="490.8" as="targetPoint"/><Array as="points"><mxPoint x="450" y="490.8"/></Array></mxGeometry></mxCell><mxCell id="v33" value="[an active member is chosen as the owner]&lt;br&gt;/ save To do; notify them (UC-08, UC-20)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="462" y="370.8" width="170" height="56.8" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="785" y="365.8" as="sourcePoint"/><mxPoint x="785" y="465.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v35" value="&lt;b&gt;assign&lt;/b&gt; (Owner, Manager) [an active member]&lt;br&gt;/ notify the new owner (UC-08, UC-20)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="797" y="400.6" width="260" height="30.4" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="890" y="490.8" as="sourcePoint"/><mxPoint x="1010" y="490.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v37" value="&lt;b&gt;start&lt;/b&gt; (task owner)&lt;br&gt;(UC-09)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="452.8" width="110" height="30.4" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1210" y="490.8" as="sourcePoint"/><mxPoint x="1360" y="490.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v39" value="&lt;b&gt;finish&lt;/b&gt;&lt;br&gt;(task owner) (UC-09)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1252" y="452.8" width="106" height="43.6" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1465" y="515.8" as="sourcePoint"/><mxPoint x="1110" y="515.8" as="targetPoint"/><Array as="points"><mxPoint x="1465" y="589.8"/><mxPoint x="1110" y="589.8"/></Array></mxGeometry></mxCell><mxCell id="v41" value="&lt;b&gt;reopen&lt;/b&gt; (Owner, Manager)&lt;br&gt;/ back to In progress with the same owner; no owner if they left (UC-16)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1250" y="540.2" width="200" height="43.6" as="geometry"/></mxCell><mxCell id="v42" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="673.8" width="1560" height="218.6" as="geometry"/></mxCell><mxCell id="v43" value="&lt;b&gt;The project&#x27;s task list&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· worked out from every task&#x27;s status, not saved&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="679.8" width="1536" height="18" as="geometry"/></mxCell><mxCell id="e44" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="40" y="705.8" as="sourcePoint"/><mxPoint x="1600" y="705.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v45" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="69" y="760.8" width="22" height="22" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="91" y="771.8" as="sourcePoint"/><mxPoint x="140" y="771.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v47" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="140" y="746.8" width="200" height="50" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b&gt;No tasks yet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;the team is ready to work&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="750.8" width="200" height="36" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="340" y="771.8" as="sourcePoint"/><mxPoint x="500" y="771.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v50" value="&lt;b&gt;create&lt;/b&gt; the first task&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="352" y="733.8" width="160" height="30.4" as="geometry"/></mxCell><mxCell id="v51" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="500" y="746.8" width="480" height="111.6" as="geometry"/></mxCell><mxCell id="v52" value="&lt;b&gt;Work in progress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;some task is To do or In progress&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="500" y="750.8" width="480" height="36" as="geometry"/></mxCell><mxCell id="e53" value="" style="endArrow=none;html=1;strokeColor=#9673A6;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="500" y="788.8" as="sourcePoint"/><mxPoint x="980" y="788.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v54" value="&lt;b&gt;create task&lt;/b&gt;, &lt;b&gt;assign&lt;/b&gt;, &lt;b&gt;start&lt;/b&gt;, &lt;b&gt;finish&lt;/b&gt; / each task moves as in the top part" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="508" y="794.8" width="464" height="17.2" as="geometry"/></mxCell><mxCell id="v55" value="&lt;b&gt;overdue&lt;/b&gt; (Should) / a To do or In progress task past its deadline is highlighted (scope row 50)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="508" y="814" width="464" height="36.4" as="geometry"/></mxCell><mxCell id="v56" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1170" y="746.8" width="240" height="50" as="geometry"/></mxCell><mxCell id="v57" value="&lt;b&gt;All tasks done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;every task is Done&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="750.8" width="240" height="36" as="geometry"/></mxCell><mxCell id="e58" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="980" y="763.8" as="sourcePoint"/><mxPoint x="1170" y="763.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v59" value="&lt;b&gt;when&lt;/b&gt;(every task is Done)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="992" y="741.8" width="190" height="17.2" as="geometry"/></mxCell><mxCell id="e60" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1170" y="785.8" as="sourcePoint"/><mxPoint x="980" y="785.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v61" value="&lt;b&gt;create task&lt;/b&gt;, or &lt;b&gt;reopen&lt;/b&gt; one&lt;br&gt;(Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="992" y="791.8" width="190" height="30.4" as="geometry"/></mxCell><mxCell id="v62" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1360" y="932.4" width="220" height="50" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;The credits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;step 4 · state diagram 3&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="936.4" width="220" height="36" as="geometry"/></mxCell><mxCell id="v64" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1546" y="968.4" width="10" height="7" as="geometry"/></mxCell><mxCell id="v65" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1562" y="968.4" width="10" height="7" as="geometry"/></mxCell><mxCell id="e66" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1556" y="971.9" as="sourcePoint"/><mxPoint x="1562" y="971.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1350" y="796.8" as="sourcePoint"/><mxPoint x="1470" y="932.4" as="targetPoint"/><Array as="points"><mxPoint x="1350" y="910.4"/><mxPoint x="1470" y="910.4"/></Array></mxGeometry></mxCell><mxCell id="v68" value="&lt;b&gt;open Credits&lt;/b&gt; (Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1362" y="805.8" width="200" height="17.2" as="geometry"/></mxCell><mxCell id="v69" value="&lt;b&gt;One step forward only&lt;/b&gt; (FR-TSK-01, DD-22). TaskService.updateStatus refuses To do to Done and any step back. Only reopen goes back, only from Done, and a member is refused, even the task&#x27;s own owner (FR-TSK-02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1008.4" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v70" value="&lt;b&gt;Who is the task owner?&lt;/b&gt; The member the task is assigned to (tasks.owner_id), not the project&#x27;s Owner. The project&#x27;s Owner and Managers cannot start or finish someone else&#x27;s task (US-TSK-02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="434" y="1008.4" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v71" value="&lt;b&gt;No final state for a task.&lt;/b&gt; A Done task can always be reopened, so the record never ends; it is deleted only with its project. A Done task keeps its owner, even after that member leaves." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="828" y="1008.4" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;All tasks done is not saved.&lt;/b&gt; It is worked out from tasks.status. Nothing stops the owner opening Credits earlier; the journey shows the usual order." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1222" y="1008.4" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v73" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A rounded box is a state; the small text under its name is the saved status, or what it stands for when nothing is saved. The black dot is where it starts. An arrow is a transition, labelled &lt;i&gt;event (who may trigger it) [condition] / what the system does&lt;/i&gt;; a diamond is a choice, and the path whose [condition] is true is taken. Text under a line inside a state is an internal transition, which leaves the state unchanged; &lt;i&gt;when(…)&lt;/i&gt; fires once its condition becomes true. A large box around other states is a composite state: the transitions at its top work in every state inside it. A dashed box is a Should feature; a box with the linked-boxes icon is drawn in the diagram it names. Before every event, PermissionGuard.canAct checks the actor (UC-22); a refused event changes nothing.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-TSK-01, FR-TSK-02, FR-ACC-02, NFR-SEC-04; UC-08, UC-09, UC-16, UC-18; US-TSK-01, US-TSK-02, US-TSK-03, US-TSK-04; DD-22; scope rows 36, 50, 86, 88." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1111.2" width="1560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>