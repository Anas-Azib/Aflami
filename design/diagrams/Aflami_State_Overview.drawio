<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="journey"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2231" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Aflami: state diagram overview, the whole journey&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;One project from the moment its owner creates it until the film or series is public. Each stage names the detailed state diagram (1 to 4) that holds its full rules.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1560" height="60" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1300" height="1613.8" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Draft&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· DRAFT, the project&#x27;s saved status until the owner publishes it (state diagram 4)&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="312" y="116" width="1276" height="18" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="300" y="142" as="sourcePoint"/><mxPoint x="1600" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v5" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="340" y="162" width="700" height="117.6" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Setting up the project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;step 1 · create the project&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="340" y="166" width="700" height="36" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="340" y="204" as="sourcePoint"/><mxPoint x="1040" y="204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v8" value="&lt;b&gt;update&lt;/b&gt; (Owner, Manager) / the title, the idea and the film details" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="348" y="210" width="684" height="17.2" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;upload script&lt;/b&gt; (Owner, Manager, Screenwriter) [PDF, Word, Pages or text, up to 10 MB] / only the newest is kept (UC-17, DD-16)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="348" y="229.2" width="684" height="17.2" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;film or series&lt;/b&gt; (Owner) (Should) / a series has seasons and episodes (FR-PRJ-03)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="348" y="248.4" width="684" height="23.2" as="geometry"/></mxCell><mxCell id="v11" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="335.6" width="1240" height="651.2" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Building the team&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· step 2&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="342" y="341.6" width="1216" height="18" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;AI draft&lt;/b&gt; (Owner, Manager) (Should) [the owner agreed to send the script] / the film roles and a casting call from the script; a person approves, edits or rejects them first (scope rows 85, 88, 90)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="340" y="363.6" width="1220" height="23.2" as="geometry"/></mxCell><mxCell id="e14" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="330" y="394.8" as="sourcePoint"/><mxPoint x="1570" y="394.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="1322" width="1240" height="379.8" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Preparing the film page&lt;/b&gt; &lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;· step 4&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="342" y="1328" width="1216" height="18" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;AI draft&lt;/b&gt; (Owner, Manager) (Should) / the title and the description, with the participants&#x27; names; a person approves, edits or rejects it first (scope rows 87, 88)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="340" y="1350" width="1220" height="23.2" as="geometry"/></mxCell><mxCell id="e18" value="" style="endArrow=none;html=1;strokeColor=#D6B656;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="330" y="1381.2" as="sourcePoint"/><mxPoint x="1570" y="1381.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v19" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="49" y="176" width="22" height="22" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="71" y="187" as="sourcePoint"/><mxPoint x="340" y="187" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v21" value="&lt;b&gt;create&lt;/b&gt; (Creator) [signed in as a Creator]&lt;br&gt;/ fill in the title and the idea; the Creator becomes the owner; the first episode is made (UC-02)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="48" y="114.2" width="236" height="56.8" as="geometry"/></mxCell><mxCell id="v22" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="382" y="480.8" width="36" height="36" as="geometry"/></mxCell><mxCell id="v23" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="473.8" width="260" height="50" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Invitation pending&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;invitations: PENDING&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="477.8" width="260" height="36" as="geometry"/></mxCell><mxCell id="v25" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1180" y="473.8" width="370" height="144" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;The team&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;active members and their film roles&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1180" y="477.8" width="370" height="36" as="geometry"/></mxCell><mxCell id="e27" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1180" y="515.8" as="sourcePoint"/><mxPoint x="1550" y="515.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v28" value="&lt;b&gt;make manager&lt;/b&gt; (Owner) / the member gets manager rights (UC-03)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="1188" y="521.8" width="354" height="17.2" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;post announcement&lt;/b&gt; (Owner, Manager) / every active member is notified (US-TEAM-05)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="1188" y="541" width="354" height="30.4" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;leave&lt;/b&gt; (member) (Should) / marked as left; their open tasks lose their owner" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1188" y="573.4" width="354" height="36.4" as="geometry"/></mxCell><mxCell id="v31" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="613.8" width="300" height="105.6" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Casting call open&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;casting_calls: OPEN, with a public link&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="617.8" width="300" height="36" as="geometry"/></mxCell><mxCell id="e33" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="660" y="655.8" as="sourcePoint"/><mxPoint x="960" y="655.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="&lt;b&gt;submit&lt;/b&gt; (Creator) / a Submitted application (UC-05)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="668" y="661.8" width="284" height="17.2" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;edit&lt;/b&gt; (Owner, Manager) / the same link shows the change (UC-04, 1a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="668" y="681" width="284" height="30.4" as="geometry"/></mxCell><mxCell id="v36" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="824.4" width="300" height="98.4" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Reviewing applications&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;each application: state diagram 1&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="828.4" width="300" height="36" as="geometry"/></mxCell><mxCell id="e38" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="660" y="866.4" as="sourcePoint"/><mxPoint x="960" y="866.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v39" value="&lt;b&gt;shortlist&lt;/b&gt; or &lt;b&gt;unshortlist&lt;/b&gt; (Owner, Manager) / only the team sees the mark (UC-19)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="668" y="872.4" width="284" height="30.4" as="geometry"/></mxCell><mxCell id="v40" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="926" y="908.8" width="10" height="7" as="geometry"/></mxCell><mxCell id="v41" value="" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="942" y="908.8" width="10" height="7" as="geometry"/></mxCell><mxCell id="e42" value="" style="endArrow=none;html=1;strokeColor=#D79B00;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="936" y="912.3" as="sourcePoint"/><mxPoint x="942" y="912.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v43" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1347" y="831.4" width="36" height="36" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="400" y="279.6" as="sourcePoint"/><mxPoint x="400" y="480.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v45" value="&lt;b&gt;add people&lt;/b&gt; (Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="410" y="285.6" width="200" height="17.2" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1365" y="473.8" as="sourcePoint"/><mxPoint x="400" y="480.8" as="targetPoint"/><Array as="points"><mxPoint x="1365" y="420.8"/><mxPoint x="400" y="420.8"/></Array></mxGeometry></mxCell><mxCell id="v47" value="&lt;b&gt;add more people&lt;/b&gt; (Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="760" y="400.8" width="260" height="17.2" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="418" y="498.8" as="sourcePoint"/><mxPoint x="660" y="498.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v49" value="[a specific person, already on Aflami]&lt;br&gt;/ invite them for a film role; notify them (UC-07, UC-20)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="422" y="449.2" width="236" height="43.6" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="920" y="490.8" as="sourcePoint"/><mxPoint x="1180" y="490.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v51" value="&lt;b&gt;accept&lt;/b&gt; (invitee)&lt;br&gt;/ addMember with the film role (UC-13, UC-21)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="932" y="454.4" width="260" height="30.4" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="920" y="512.8" as="sourcePoint"/><mxPoint x="1180" y="512.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v53" value="&lt;b&gt;decline&lt;/b&gt; (invitee) / nobody joins (UC-13)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="932" y="516.8" width="260" height="17.2" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="400" y="516.8" as="sourcePoint"/><mxPoint x="660" y="638.8" as="targetPoint"/><Array as="points"><mxPoint x="400" y="638.8"/></Array></mxGeometry></mxCell><mxCell id="v55" value="[no one specific yet]&lt;br&gt;/ &lt;b&gt;publishCall&lt;/b&gt;: a film role, a description and a future deadline; a public link that any Creator can apply from (UC-04, UC-05)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="412" y="532.8" width="236" height="56.8" as="geometry"/></mxCell><mxCell id="e56" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="810" y="719.4" as="sourcePoint"/><mxPoint x="810" y="824.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v57" value="&lt;b&gt;close&lt;/b&gt; (Owner, Manager), or &lt;b&gt;when&lt;/b&gt;(the deadline has passed)&lt;br&gt;/ no new applications; the waiting ones stay (UC-04 1b, open question 3)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="822" y="750.1" width="330" height="43.6" as="geometry"/></mxCell><mxCell id="e58" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="960" y="849.4" as="sourcePoint"/><mxPoint x="1347" y="849.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v59" value="&lt;b&gt;decide&lt;/b&gt; (Owner, Manager)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="972" y="827.4" width="200" height="17.2" as="geometry"/></mxCell><mxCell id="e60" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1365" y="831.4" as="sourcePoint"/><mxPoint x="1365" y="617.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v61" value="[accept]&lt;br&gt;/ addMember with the call&#x27;s film role; notify &quot;accepted&quot; (UC-06, UC-21)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1377" y="775.8" width="190" height="43.6" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1365" y="867.4" as="sourcePoint"/><mxPoint x="810" y="922.8" a