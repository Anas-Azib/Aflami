="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="512" y="1637.8" as="sourcePoint"/><mxPoint x="370" y="1478.2" as="targetPoint"/><Array as="points"><mxPoint x="350" y="1637.8"/><mxPoint x="350" y="1478.2"/></Array></mxGeometry></mxCell><mxCell id="v102" value="[else] / show what is missing; stays Draft (UC-11, 4a)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="360" y="1643.8" width="180" height="30.4" as="geometry"/></mxCell><mxCell id="v103" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="380" y="1819.8" width="560" height="148.8" as="geometry"/></mxCell><mxCell id="v104" value="&lt;b&gt;Published&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;PUBLISHED · the film or series is public&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="380" y="1823.8" width="560" height="36" as="geometry"/></mxCell><mxCell id="e105" value="" style="endArrow=none;html=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="380" y="1861.8" as="sourcePoint"/><mxPoint x="940" y="1861.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v106" value="&lt;b&gt;watch&lt;/b&gt; (anyone, no account needed) / the details, the credits and the YouTube player (UC-12)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;" vertex="1" parent="1"><mxGeometry x="388" y="1867.8" width="544" height="17.2" as="geometry"/></mxCell><mxCell id="v107" value="&lt;b&gt;rate&lt;/b&gt; (a Creator outside the team) (Should) / one rating each; the page shows the average (UC-14)" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="388" y="1887" width="544" height="23.2" as="geometry"/></mxCell><mxCell id="v108" value="&lt;b&gt;react&lt;/b&gt; (a signed-in user) (Should) / like or dislike" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="388" y="1912.2" width="544" height="23.2" as="geometry"/></mxCell><mxCell id="v109" value="&lt;b&gt;publish episode&lt;/b&gt; (Owner) (Should) / a series releases its episodes one at a time" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=4;fillColor=none;dashed=1;dashPattern=4 3;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="388" y="1937.4" width="544" height="23.2" as="geometry"/></mxCell><mxCell id="v110" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1180" y="1819.8" width="220" height="50" as="geometry"/></mxCell><mxCell id="v111" value="&lt;b&gt;Hidden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;HIDDEN&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="1180" y="1823.8" width="220" height="36" as="geometry"/></mxCell><mxCell id="e112" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="530" y="1655.8" as="sourcePoint"/><mxPoint x="530" y="1819.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v113" value="[a YouTube link, and every credit Approved]&lt;br&gt;/ publishedAt; the page is public (UC-11)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="542" y="1737.8" width="300" height="30.4" as="geometry"/></mxCell><mxCell id="e114" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="940" y="1835.8" as="sourcePoint"/><mxPoint x="1180" y="1835.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v115" value="&lt;b&gt;hide&lt;/b&gt; (Owner)&lt;br&gt;/ visitors can no longer open it; the team still can (UC-15)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="952" y="1786.2" width="220" height="43.6" as="geometry"/></mxCell><mxCell id="e116" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#333333;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1180" y="1857.8" as="sourcePoint"/><mxPoint x="940" y="1857.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v117" value="&lt;b&gt;show&lt;/b&gt; (Owner)&lt;br&gt;/ public again, ratings kept (UC-15)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1A1A1A;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="952" y="1863.8" width="220" height="30.4" as="geometry"/></mxCell><mxCell id="v118" value="&lt;b&gt;Going back.&lt;/b&gt; The journey shows the usual order, but nothing locks a step: the owner can add people while tasks are in progress, accept or reject while a call is still open, and edit a credit after publishing (it leaves the page until it is approved again)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2004.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v119" value="&lt;b&gt;Who may act.&lt;/b&gt; The Owner and Managers run steps 2 to 4. Only the Owner makes managers, publishes, hides and shows (FR-ACC-03, FR-FILM-03). Every event passes PermissionGuard.canAct first (UC-22)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="434" y="2004.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v120" value="&lt;b&gt;Saved statuses.&lt;/b&gt; Draft, Published and Hidden are the project&#x27;s status (projects.status). The stages inside Draft show where the owner is in the journey; invitations, calls, applications, tasks and credits keep their own status." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="828" y="2004.6" width="377" height="74.8" as="geometry"/></mxCell><mxCell id="v121" value="&lt;b&gt;No final state.&lt;/b&gt; Archiving or deleting a project is Should and its rules are not decided yet (scope row 43), so the journey ends with the film public, or hidden by its owner." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=9;spacingRight=16;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1222" y="2004.6" width="377" height="61.6" as="geometry"/></mxCell><mxCell id="v122" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A rounded box is a state; the small text under its name is its saved status or what it stands for. A box with the linked-boxes icon has its full rules in the state diagram it names. A large box around other states is a composite state, and an arrow that leaves it can leave from any state inside it. A diamond is a choice: the path whose [condition] is true is taken. An arrow is a transition, labelled &lt;i&gt;event (who may trigger it) [condition] / what the system does&lt;/i&gt;; text under a line inside a state is an internal transition, which leaves the state unchanged. A dashed box is a Should feature. Colours follow the modules: green Projects, orange Casting and team, purple Tasks, yellow Film page.&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; the MVP journey; FR-PRJ-01, FR-PRJ-03, FR-ACC-03, FR-CST-01, FR-CST-02, FR-TEAM-02, FR-TSK-01, FR-TSK-02, FR-FILM-01, FR-FILM-02, FR-FILM-03; UC-02 to UC-16; state diagrams 1 to 4." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2107.4" width="1560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>