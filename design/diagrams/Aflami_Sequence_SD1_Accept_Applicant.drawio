<mxfile host="drawio" type="device" pages="1"><diagram id="d1" name="accept an applicant (SD-1)"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1749" pageHeight="1413" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="&lt;b&gt;Aflami: sequence diagram 1 of 4, accept an applicant (SD-1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#555555&quot;&gt;The owner or a manager accepts a Submitted application; the applicant joins the team with the call's film role.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1669.44" height="56" as="geometry" /></mxCell><mxCell id="v2" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#4D4D4D;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60.0215" y="316" width="1649.41" height="860" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#4D4D4D;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="60.0215" y="420" as="sourcePoint" /><mxPoint x="1709.44" y="420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;boundedLbl=1;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#4D4D4D;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="927.814" y="598" width="765.621" height="278" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#4D4D4D;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="927.814" y="674" as="sourcePoint" /><mxPoint x="1693.44" y="674" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v6" value="Owner or Manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#1A1A1A;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="125.021" y="82" width="26" height="42" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="138.021" y="146" as="sourcePoint" /><mxPoint x="138.021" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v8" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«Next.js»&lt;/font&gt;&lt;br&gt;&lt;b&gt;:Web app&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="307.506" y="96" width="110" height="46" as="geometry" /></mxCell><mxCell id="e9" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="362.506" y="142" as="sourcePoint" /><mxPoint x="362.506" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v10" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«service» Shared&lt;/font&gt;&lt;br&gt;&lt;b&gt;:PermissionGuard&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="446.492" y="96" width="132.027" height="46" as="geometry" /></mxCell><mxCell id="e11" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="512.506" y="142" as="sourcePoint" /><mxPoint x="512.506" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v12" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«service» Casting and team&lt;/font&gt;&lt;br&gt;&lt;b&gt;:ApplicationService&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="643.013" y="96" width="151.975" height="46" as="geometry" /></mxCell><mxCell id="e13" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="719" y="142" as="sourcePoint" /><mxPoint x="719" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v14" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«service» Casting and team&lt;/font&gt;&lt;br&gt;&lt;b&gt;:MembershipService&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="913.827" y="96" width="151.975" height="46" as="geometry" /></mxCell><mxCell id="e15" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="989.814" y="142" as="sourcePoint" /><mxPoint x="989.814" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v16" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«service» Shared&lt;/font&gt;&lt;br&gt;&lt;b&gt;:ActivityLogService&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1227.53" y="96" width="140.037" height="46" as="geometry" /></mxCell><mxCell id="e17" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1297.55" y="142" as="sourcePoint" /><mxPoint x="1297.55" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v18" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«service» Shared&lt;/font&gt;&lt;br&gt;&lt;b&gt;:NotificationService&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1391.57" y="96" width="140.693" height="46" as="geometry" /></mxCell><mxCell id="e19" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1461.91" y="142" as="sourcePoint" /><mxPoint x="1461.91" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v20" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#555555&quot;&gt;«PostgreSQL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;:Database&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1596.44" y="96" width="110" height="46" as="geometry" /></mxCell><mxCell id="e21" value="" style="endArrow=none;html=1;dashed=1;dashPattern=5 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1651.44" y="142" as="sourcePoint" /><mxPoint x="1651.44" y="1206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v22" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="356.506" y="198" width="12" height="208" as="geometry" /></mxCell><mxCell id="v23" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="713" y="232" width="12" height="140" as="geometry" /></mxCell><mxCell id="v24" value="" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="506.506" y="266" width="12" height="34" as="geometry" /></mxCell><mxCell id="v25" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="713" y="420" width="12" height="706" as="geometry" /></mxCell><mxCell id="v26" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="356.506" y="420" width="12" height="740" as="geometry" /></mxCell><mxCell id="v27" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="474" width="12" height="16" as="geometry" /></mxCell><mxCell id="v28" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="983.814" y="514" width="12" height="396" as="geometry" /></mxCell><mxCell id="v29" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="548" width="12" height="34" as="geometry" /></mxCell><mxCell id="v30" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="654" width="12" height="16" as="geometry" /></mxCell><mxCell id="v31" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="778" width="12" height="16" as="geometry" /></mxCell><mxCell id="v32" value="" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1291.55" y="944" width="12" height="50" as="geometry" /></mxCell><mxCell id="v33" value="" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1455.91" y="1018" width="12" height="74" as="geometry" /></mxCell><mxCell id="v34" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="1052" width="12" height="16" as="geometry" /></mxCell><mxCell id="v35" value="" style="rounded=0;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="989.814" y="740" width="12" height="18" as="geometry" /></mxCell><mxCell id="e36" value="1. Choose Accept on an application" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="138.021" y="198" as="sourcePoint" /><mxPoint x="356.506" y="198" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e37" value="2. accept(app, actor)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="368.506" y="232" as="sourcePoint" /><mxPoint x="713" y="232" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e38" value="3. canAct(actor, project, &quot;accept&quot;)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="713" y="266" as="sourcePoint" /><mxPoint x="518.506" y="266" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e39" value="4. allowed or refused" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="518.506" y="300" as="sourcePoint" /><mxPoint x="713" y="300" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e40" value="5. refused: nothing changes" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="713" y="372" as="sourcePoint" /><mxPoint x="368.506" y="372" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e41" value="6. show why" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="356.506" y="406" as="sourcePoint" /><mxPoint x="138.021" y="406" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e42" value="7. save application: ACCEPTED, decidedBy, decidedAt" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="725" y="474" as="sourcePoint" /><mxPoint x="1645.44" y="474" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e43" value="8. addMember(project, applicant, call.filmRole)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="725" y="514" as="sourcePoint" /><mxPoint x="983.814" y="514" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e44" value="9. find membership (applicant, project)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="995.814" y="548" as="sourcePoint" /><mxPoint x="1645.44" y="548" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e45" value="10. membership or none" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1645.44" y="582" as="sourcePoint" /><mxPoint x="995.814" y="582" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e46" value="11. insert membership (MEMBER, ACTIVE) and its member role" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="995.814" y="654" as="sourcePoint" /><mxPoint x="1645.44" y="654" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e47" value="" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="995.814" y="728" as="sourcePoint" /><mxPoint x="1001.81" y="746" as="targetPoint" /><Array as="points"><mxPoint x="1025.81" y="728" /><mxPoint x="1025.81" y="746" /></Array></mxGeometry></mxCell><mxCell id="v48" value="12. addFilmRole(m, call.filmRole, null)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1029.81" y="719" width="231.732" height="18" as="geometry" /></mxCell><mxCell id="e49" value="13. insert the new member role" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="995.814" y="778" as="sourcePoint" /><mxPoint x="1645.44" y="778" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e50" value="15. membership" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="983.814" y="910" as="sourcePoint" /><mxPoint x="725" y="910" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e51" value="16. record(project, actor, &quot;accept&quot;, app.id)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="725" y="944" as="sourcePoint" /><mxPoint x="1291.55" y="944" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e52" value="18. notify(applicant, &quot;accepted&quot;, app.id)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="725" y="1018" as="sourcePoint" /><mxPoint x="1455.91" y="1018" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e53" value="19. insert notification (unread)" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1467.91" y="1052" as="sourcePoint" /><mxPoint x="1645.44" y="1052" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e54" value="20. notification" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1455.91" y="1092" as="sourcePoint" /><mxPoint x="725" y="1092" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e55" value="21. membership" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="713" y="1126" as="sourcePoint" /><mxPoint x="368.506" y="1126" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e56" value="22. show the new member in the team" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;dashed=1;dashPattern=6 4;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="356.506" y="1160" as="sourcePoint" /><mxPoint x="138.021" y="1160" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="v57" value="[refused, or the application is no longer Submitted]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="372.5" y="318" width="253.199" height="16" as="geometry" /></mxCell><mxCell id="v58" value="[allowed]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="422" width="51.4121" height="16" as="geometry" /></mxCell><mxCell id="v59" value="[no membership yet]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="999.8" y="600" width="107.656" height="16" as="geometry" /></mxCell><mxCell id="v60" value="[already an ACTIVE member]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="999.8" y="676" width="171.24" height="16" as="geometry" /></mxCell><mxCell id="v61" value="&lt;b&gt;Rules.&lt;/b&gt; Saving the decision, the membership and the activity line happen in one database transaction, so a half-done acceptance cannot remain; the database also refuses a second membership for the same person and project (DD-19), so a person who left before is made ACTIVE again instead of joining twice. The applicant sees the decision in their notifications inside Aflami; version 1 sends no email. &lt;b&gt;Reject&lt;/b&gt; runs the same way with reject(app, actor): the application becomes Rejected, the applicant is notified, and no membership is made. &lt;b&gt;Shortlist&lt;/b&gt; (UC-19) only sets the shortlisted flag and sends no notification, because the applicant must not see it (DD-14).&lt;br&gt;&lt;b&gt;Covers&lt;/b&gt; FR-CST-02, FR-TEAM-01, FR-ACC-02; UC-06 with UC-20, UC-21 and UC-22." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="1669.44" height="59.6" as="geometry" /></mxCell><mxCell id="v62" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Time runs from top to bottom. A box at the top is a participant: &lt;i&gt;:ApplicationService&lt;/i&gt; means an object of that class from the class diagrams, coloured by its module (orange Casting and team, purple Tasks, yellow Film page, green Projects, grey Shared; white for the web app, the database and YouTube). The dashed line under it is its lifeline, and the thin bar shows when it is busy. A solid arrow with a filled head is a call, written as the method and its arguments; a dashed arrow with an open head is the answer. A call that only saves something has no answer arrow. A frame groups messages: &lt;b&gt;alt&lt;/b&gt; runs only the part whose [condition] holds (dashed lines separate the parts), &lt;b&gt;opt&lt;/b&gt; runs only if its condition holds, and &lt;b&gt;loop&lt;/b&gt; repeats. Words in quotes, such as &quot;accept&quot;, are values whose exact names are set in the code. canAct is the permission check; SD-4 shows how it decides." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="1303.6" width="1669.44" height="79.6" as="geometry" /></mxCell><mxCell id="x1" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#4D4D4D;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="927.814" y="800" as="sourcePoint" /><mxPoint x="1693.435" y="800" as="targetPoint" /></mxGeometry></mxCell><mxCell id="x2" value="[left the project before: status LEFT]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="999.8" y="802" width="219.1" height="16" as="geometry" /></mxCell><mxCell id="x3" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="846" width="12" height="16" as="geometry" /></mxCell><mxCell id="x4" value="14. set the membership ACTIVE again and insert its member role" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="995.814" y="846" as="sourcePoint" /><mxPoint x="1645.44" y="846" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="x5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1645.44" y="978" width="12" height="16" as="geometry" /></mxCell><mxCell id="x6" value="17. insert activity line" style="html=1;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1303.55" y="978" as="sourcePoint" /><mxPoint x="1645.44" y="978" as="targetPoint" /><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>