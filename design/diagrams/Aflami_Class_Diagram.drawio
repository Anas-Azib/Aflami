d="k109" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;spacing=1;" vertex="1" connectable="0" parent="k107"><mxGeometry x="0.813" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="k110" value="&lt;b&gt;Accounts&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Services: AccountService, NotificationService&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="1040.0" width="269.8" height="78" as="geometry"/></mxCell><mxCell id="k111" value="&lt;b&gt;Projects&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Services: ProjectService, ScriptService, FileService, ActivityLogService&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="345.8" y="1040.0" width="269.8" height="78" as="geometry"/></mxCell><mxCell id="k112" value="&lt;b&gt;Casting and team&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Services: CastingService, ApplicationService, InvitationService, MembershipService, AnnouncementService&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="631.6" y="1040.0" width="269.8" height="78" as="geometry"/></mxCell><mxCell id="k113" value="&lt;b&gt;Tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Services: TaskService&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="917.4000000000001" y="1040.0" width="269.8" height="78" as="geometry"/></mxCell><mxCell id="k114" value="&lt;b&gt;Film page&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Services: CreditService, RatingService&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1203.2" y="1040.0" width="269.8" height="78" as="geometry"/></mxCell><mxCell id="k115" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A solid line is an association; the numbers at its ends say how many (1 exactly one, 0..1 zero or one, 0..* zero or more, 1..* one or more). A filled diamond means composition: the part cannot exist without the whole (an application without its casting call). A dashed open arrow means &quot;uses&quot;: a service calls another service or changes that class. Attributes start with -, methods with +; [0..1] marks an optional value.&lt;br&gt;Every service checks PermissionGuard before it changes a project. Reaction (dashed) is a Should feature. Task, Credit and CastingCall can also point to one Episode, for a series; diagram 3 shows it for tasks and credits. Lines to User for who did something (an announcement's author, an activity's actor, who approved a credit) are left out to keep the diagram readable; the ERD lists them." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="1136.0" width="1413" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>