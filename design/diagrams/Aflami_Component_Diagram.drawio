t-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;GitHub Actions, once a day&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="300" height="95" as="geometry"/></mxCell><mxCell id="c50" value="" style="shape=module;jettyWidth=6;jettyHeight=3;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="334" y="958" width="16" height="18" as="geometry"/></mxCell><mxCell id="c51" value="" style="html=1;rounded=0;strokeColor=#4D4D4D;strokeWidth=1.2;fontSize=10.5;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c49" target="c37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="905"/></Array></mxGeometry></mxCell><mxCell id="c52" value="encrypted export" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#333333;labelBackgroundColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="884" width="110" height="18" as="geometry"/></mxCell><mxCell id="c53" value="" style="html=1;rounded=0;strokeColor=#4D4D4D;strokeWidth=1.2;fontSize=10.5;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c49" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="997"/><mxPoint x="20" y="262"/></Array></mxGeometry></mxCell><mxCell id="c54" value="cleanup call" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#333333;labelBackgroundColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="640" width="76" height="18" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A box with the small icon is a component, a part that can be built, tested and replaced on its own; the coloured boxes are the NestJS modules inside the back end, in the same colours as the class diagrams. A circle on a stick is an interface the component provides. A dashed arrow means &quot;uses&quot;: the part at its tail calls the part or interface at its head. Dashed borders mark Should features; grey boxes are outside services. The arrows between modules always point one way, so the modules never call each other in a circle." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;align=left;verticalAlign=top;spacing=8;spacingTop=2;fontSize=11;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1400" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>